# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_NAME=financial-news-intelligence-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                              # Uvicorn hot-reload (dev only)

# ── News Sources ──────────────────────────────────────────────────────────────
NEWSAPI_API_KEY=your_newsapi_key_here
RSS_FEED_URLS=https://feeds.finance.yahoo.com/rss/2.0/headline,https://www.investing.com/rss/news.rss

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=financial_news
MONGODB_ARTICLES_COLLECTION=articles

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL=3600                         # Seconds

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NEWS_PROCESSED=news.processed
KAFKA_TOPIC_NEWS_RAW=news.raw
KAFKA_CONSUMER_GROUP_ID=financial-news-consumer
KAFKA_AUTO_OFFSET_RESET=earliest

# ── NLP / Models ──────────────────────────────────────────────────────────────
NLP_SENTIMENT_MODEL=ProsusAI/finbert        # HuggingFace model ID
NLP_NER_MODEL=en_core_web_sm               # spaCy model name
NLP_BATCH_SIZE=32
NLP_MAX_TEXT_LENGTH=512

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
GCS_BUCKET_NAME=your_gcs_backup_bucket
GCP_SERVICE_ACCOUNT_KEY_PATH=/path/to/credentials.json

# ── Integrations (upstream P-03 / downstream P-05, P-08) ─────────────────────
P03_KAFKA_TOPIC_MARKET_EVENTS=market.events.raw
P05_KAFKA_TOPIC=signals.sentiment
P08_KAFKA_TOPIC=anomaly.inputs.news
